NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
# Use an Atlas mongodb+srv URI. No local database is started.
MONGODB_URI=
MONGODB_DB=strive_screening
SESSION_SECRET=
# First-run assessor login. Set before starting with Atlas enabled.
ASSESSOR_EMAIL=assessor@example.com
ASSESSOR_PASSWORD=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_THINKING_LEVEL=MINIMAL
# Minimal thinking reduces overhead; incomplete output is never accepted.
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Minimum spacing between requests for each model; tune to your project's allowance.
GEMINI_MIN_REQUEST_INTERVAL_MS=12000
# Automatic hosted fallback for generation; embeddings remain Gemini-compatible.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MIN_REQUEST_INTERVAL_MS=3000
GROQ_MAX_COMPLETION_TOKENS=4096
SARVAM_API_KEY=
SARVAM_MODEL=saaras:v4
# "gemini" is an explicit alternative for audio if Sarvam is unavailable.
AUDIO_PROVIDER=sarvam
# Optional exclusive inference on your own cloud GPU. Keep blank until ready.
CLOUD_AI_URL=
CLOUD_AI_TOKEN=
CLOUD_AI_MODEL=Qwen/Qwen3.5-9B
# Use 930000 for the Docker CPU service.
CLOUD_AI_TIMEOUT_MS=150000
# After cloud validation, use AUDIO_PROVIDER=cloud for your own speech service.
# Optional system FFmpeg override; ffmpeg-static is used otherwise.
FFMPEG_PATH=
MODEL_SERVICE_URL=
MODEL_SERVICE_TOKEN=
# Optional managed nearby-business lookup; server-side only. https://myprojects.geoapify.com/
GEOAPIFY_API_KEY=
OSM_USER_AGENT=StriveScreening/1.0 (hackathon demo; configure contact)
MAX_UPLOAD_MB=10
ENABLE_EXAMPLES=true
PROCESSING_CONCURRENCY=1
# model-service only: absolute path to the artefact exported by cloud training
MODEL_ARTIFACT_PATH=
