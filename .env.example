# Copy to .env.local. Never commit real values. Use separate dev and production projects.
APP_ENV=development
PUBLIC_WEB_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
ALLOW_PAID_SERVICES=false
MODEL_RUNTIME=owned_worker
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AUTH_ISSUER=
AUTH_AUDIENCE=authenticated
AUTH_JWKS_URL=
PRIVATE_UPLOAD_BUCKET=originals
WORKER_CREDENTIAL=
STAGE_CAPABILITY_SIGNING_KEY=
HF_TOKEN=
ENABLE_PUBLIC_NOMINATIM=false
# Vite reads apps/web/.env.local; use these public identifiers there.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
