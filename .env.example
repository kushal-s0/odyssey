# Copy to .env.local. Never commit real values. Use separate dev and production projects.
APP_ENV=development
PUBLIC_WEB_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
ALLOW_PAID_SERVICES=false
MODEL_RUNTIME=owned_worker
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AUTH_ISSUER=
AUTH_AUDIENCE=authenticated
AUTH_JWKS_URL=
PRIVATE_UPLOAD_BUCKET=originals
STORAGE_BACKEND=supabase
# Explicit development/test option only: STORAGE_BACKEND=local
# Production rejects local disk as durable storage. No automatic fallback.
WORKER_CREDENTIAL=
WORKER_API_URL=http://127.0.0.1:8000
WORKER_ID=owned-laptop
STAGE_CAPABILITY_SIGNING_KEY=
HF_TOKEN=
# Optional, explicitly selected owned Gradio targets; not public borrowed demos.
TEXT_DOCUMENT_SPACE_URL=
SPEECH_TRANSLATION_SPACE_URL=
ENABLE_PUBLIC_NOMINATIM=false
# Local frontend reads this same root file; only VITE_ values enter browser assets.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
