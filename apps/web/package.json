    "@playwright/test": "1.64.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "10.13.0",
    "openapi-typescript": "7.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.1.10"
  }
